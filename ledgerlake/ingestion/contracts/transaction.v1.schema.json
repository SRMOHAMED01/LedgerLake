{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerlake.local/contracts/transaction.v1.schema.json",
  "title": "LedgerLake transaction event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "event_timestamp", "producer", "transaction_id", "customer_id", "amount", "currency", "type", "merchant", "country", "timestamp"],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"const": "TRANSACTION_CREATED"},
    "schema_version": {"const": 1},
    "event_timestamp": {"type": "string", "format": "date-time"},
    "producer": {"const": "transaction-producer"},
    "transaction_id": {"type": "string", "format": "uuid"},
    "customer_id": {"type": "string", "format": "uuid"},
    "amount": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"enum": ["MAD", "EUR", "USD"]},
    "type": {"enum": ["CARD_PAYMENT", "TRANSFER", "ATM_WITHDRAWAL", "LOAN_REPAYMENT"]},
    "merchant": {"type": "string", "minLength": 1},
    "country": {"enum": ["MA", "Morocco", "Maroc", "FR", "France", "US", "USA"]},
    "timestamp": {"type": "string", "format": "date-time"}
  }
}
