# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_TRANSACTIONS=transactions-events
KAFKA_TOPIC_CUSTOMERS=customers-events
KAFKA_TOPIC_LOANS=loan-events
KAFKA_TOPIC_FRAUD=fraud-events

# ---- MinIO (S3-compatible storage) ----
MINIO_ROOT_USER=ledgerlake
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver

# ---- Analytics warehouse (Gold layer) ----
# Choix simple pour débuter : DuckDB (fichier local, pas de serveur)
# Alternative si tu veux rester cohérent avec CreditPulse : PostgreSQL
WAREHOUSE_TYPE=duckdb
WAREHOUSE_PATH=./gold.duckdb

# ---- Airflow ----
AIRFLOW_UID=50000

# ---- OpenMetadata ----
OPENMETADATA_HOST=http://openmetadata:8585
