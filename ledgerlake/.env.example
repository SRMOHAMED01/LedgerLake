# ============================================================
# .env.example — LedgerLake Environment Variables
# Copy to .env and adjust as needed
# ============================================================

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092
KAFKA_TOPIC_TRANSACTIONS=transactions-events
KAFKA_TOPIC_CUSTOMERS=customers-events
KAFKA_TOPIC_LOANS=loan-events
KAFKA_TOPIC_FRAUD=fraud-events

# ---- Deterministic event generation ----
EVENT_SEED=20260921
CUSTOMER_POPULATION=1000
EVENT_COUNT=1000
EVENT_INTERVAL_SECONDS=0
BASE_EVENT_TIME=2026-01-01T00:00:00Z
EVENT_SCENARIO=valid

# ---- Bronze Writer batch settings ----
BRONZE_WRITER_MAX_MESSAGES=1000
BRONZE_WRITER_MAX_SECONDS=60

# ---- Producer batch counts (for DAG) ----
TRANSACTION_PRODUCER_COUNT=1000
CUSTOMER_PRODUCER_COUNT=1000
LOAN_PRODUCER_COUNT=1000

# ---- MinIO (S3-compatible storage) ----
MINIO_ROOT_USER=ledgerlake
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_ENDPOINT_HOST=http://localhost:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_SILVER_REJECTED=silver-rejected

# ---- Analytics warehouse (Gold layer) ----
WAREHOUSE_TYPE=duckdb
WAREHOUSE_PATH=/tmp/duckdb/ledgerlake.duckdb
DUCKDB_PATH=/tmp/duckdb/ledgerlake.duckdb

# ---- Airflow ----
AIRFLOW_UID=50000
AIRFLOW__WEBSERVER__SECRET_KEY=ledgerlake_secret_key_change_in_prod

# ---- OpenMetadata ----
OPENMETADATA_HOST=http://openmetadata-server:8585
OPENMETADATA_HOST_EXTERNAL=http://localhost:8585

# ---- Observability ----
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- Spark ----
SPARK_MASTER_MEMORY=1g
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2